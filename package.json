{
  "name": "yazan-al-samman-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "payload": "payload",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:seed": "payload run src/cms/scripts/seed.ts",
    "cms:import-portrait": "payload run src/cms/scripts/import-portrait.ts",
    "cms:import-legacy": "payload run src/cms/scripts/import-legacy.ts",
    "cms:apply-owner": "payload run src/cms/scripts/apply-owner-content.ts",
    "cms:apply-phase14": "payload run src/cms/scripts/apply-phase14-content.ts",
    "cms:verify-legacy": "payload run src/cms/scripts/verify-legacy.ts",
    "test:cms": "vitest run --config vitest.cms.config.mts",
    "seo:share-images": "node scripts/generate-share-images.mjs",
    "seo:audit": "node tests/deployment/seo-audit.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-three/fiber": "9.8.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
