# Copy to `.env` for development. Never commit real `.env*` files (see .gitignore).
# All variables are validated at startup/build (src/lib/env.ts, src/cms/env.ts) — invalid values fail fast.
# Every value below is a PLACEHOLDER. Generate real secrets locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Site ---------------------------------------------------------------------
# Canonical origin used for canonical URLs, hreflang, Open Graph, the sitemap, CSRF and CORS.
# Production: https://yazanalsamman.com  (no trailing slash)
SITE_URL=http://localhost:3000

# Deployment environment. Only `production` makes the site indexable (robots.txt allow + sitemap)
# and sets Secure auth cookies. Any other value emits `Disallow: /` and noindex headers.
# Values: development | preview | production
SITE_ENV=development

# Enables the internal design-system preview route (/design-system, noindex).
# Defaults to on outside production; must stay unset/false in production.
DESIGN_PREVIEW=true

# --- Database (docker-compose.yml, project-scoped PostgreSQL 17) ------------------
POSTGRES_DB=yazan_portfolio
POSTGRES_USER=yazan_portfolio
POSTGRES_PASSWORD=change-me-generate-a-random-value
POSTGRES_PORT=5439
DATABASE_URL=postgresql://yazan_portfolio:change-me-generate-a-random-value@127.0.0.1:5439/yazan_portfolio

# --- CMS (Payload) --------------------------------------------------------------
# At least 32 characters each. Rotating PAYLOAD_SECRET invalidates all sessions.
PAYLOAD_SECRET=change-me-at-least-32-characters-long-random-value
# Signs out-of-process cache revalidation requests (POST /api/internal/revalidate).
REVALIDATE_SECRET=change-me-at-least-32-characters-long-random-value
# Uploaded media (images/, documents/). On the VPS: a persistent volume.
MEDIA_DIR=media

# --- First admin (used ONLY by `pnpm cms:seed` when no user exists; never by the web server) ---
# Anonymous sign-up is disabled; this is the only way the first admin is created.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
