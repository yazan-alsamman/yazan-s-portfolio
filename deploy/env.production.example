# Production configuration template. Copy to deploy/.env.production on the VPS (git-ignored,
# chmod 600) and replace every value. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# Use HEX values for POSTGRES_PASSWORD: it is embedded in a connection URL (no @ : / characters).

# --- Site ------------------------------------------------------------------------
SITE_URL=https://yazanalsamman.com
SITE_ENV=production

# --- Database (container `postgres`, loopback port for builds and backups) --------
POSTGRES_DB=yazan_portfolio
POSTGRES_USER=yazan_portfolio
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_HOST_PORT=5433

# --- CMS ---------------------------------------------------------------------------
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32

# --- App container -----------------------------------------------------------------
# Host port the reverse proxy forwards to (bound to 127.0.0.1 only).
APP_PORT=3000
# Image the app service runs; deploy.sh tags every build as yazan-portfolio:<git sha> and
# points yazan-portfolio:current at the deployed one.
APP_IMAGE=yazan-portfolio:current

# --- Build ---------------------------------------------------------------------------
# How the image build reaches PostgreSQL (static pages are generated from the CMS, R-33).
# On a Linux VPS the build runs with host networking: 127.0.0.1 + POSTGRES_HOST_PORT.
BUILD_DB_HOST=127.0.0.1
BUILD_NETWORK=host
